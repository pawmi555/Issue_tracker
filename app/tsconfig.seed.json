{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./prisma",
    "outDir": "./dist/prisma"
  },
  "include": [
    "prisma/seed.master.ts",
    "prisma/client.ts",
    "prisma/seed/seed.master.ts",
    "prisma/seed/master/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "prisma/seed.ts",
    "prisma/seed/seed.dev.ts",
    "prisma/seed/dev/**/*.ts"
  ]
}
