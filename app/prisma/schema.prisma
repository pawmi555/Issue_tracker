// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//
// =======================
// Master Table
// =======================
//

model UserRole {
  id    Int    @id @default(autoincrement())
  name  String @unique
  label String

  users User[]

  @@map("user_roles")
}

model ProjectRole {
  id    Int    @id @default(autoincrement())
  name  String @unique
  label String

  members ProjectMember[]

  @@map("project_roles")
}

model IssueStatus {
  id    Int    @id @default(autoincrement())
  name  String @unique
  label String
  sortOrder Int

  issues Issue[]

  @@map("issue_statuses")
}

model IssuePriority {
  id    Int    @id @default(autoincrement())
  name  String @unique
  label String
  sortOrder Int

  issues Issue[]

  @@map("issue_priorities")
}

model HistoryAction {
  id Int @id @default(autoincrement())

  name String @unique
  label String
  sortOrder Int

  projectHistories ProjectHistory[]
  issueHistories IssueHistory[]
  commentHistories CommentHistory[]
  user_histories UserHistory[]

  @@map("history_actions")
}

//
// =======================
// Enum
// =======================
//
enum HistoryField {
  // User
  USER_NAME
  USER_EMAIL
  USER_ROLE

  // Project
  PROJECT_NAME
  PROJECT_DESCRIPTION

  // Issue
  ISSUE_TITLE
  ISSUE_DESCRIPTION
  ISSUE_STATUS_ID
  ISSUE_PRIORITY_ID
  ISSUE_ASSIGNEE_ID
  ISSUE_DUE_DATE
  ISSUE_DELETED_AT

  // Comment
  COMMENT_CONTENT
}

//
// =======================
// User
// =======================
//

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String

  roleId       Int
  role         UserRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  ownedProjects  Project[]       @relation("UserOwnedProjects")
  memberships    ProjectMember[]
  reportedIssues Issue[]         @relation("Reporter")
  assignedIssues Issue[]         @relation("Assignee")
  comments       Comment[]


  userHistories     UserHistory[] @relation("UserHistoryTarget")
  operatedHistories UserHistory[]  @relation("UserHistoryOperator")
  projectHistories  ProjectHistory[]
  issueHistories    IssueHistory[]
  commentHistories  CommentHistory[]

  refreshTokens  RefreshToken[]
  apiRequestLogs ApiRequestLog[]

  @@map("users")
}

//
// =======================
// Project
// =======================
//

model Project {
  id          Int     @id @default(autoincrement())
  ownerId     Int
  name        String
  description String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  owner       User  @relation("UserOwnedProjects", fields: [ownerId], references: [id], onDelete: Restrict)

  members     ProjectMember[]
  issues      Issue[]

  histories   ProjectHistory[]

  @@unique([ownerId, name])
  @@index([ownerId])
  @@map("projects")
}

//
// =======================
// Project Member
// =======================
//

model ProjectMember {
  id          Int         @id @default(autoincrement())
  userId      Int
  projectId   Int

  roleId      Int
  role        ProjectRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

//
// =======================
// Issue
// =======================
//

model Issue {
  id          Int  @id @default(autoincrement())
  projectId   Int
  reporterId  Int
  assigneeId  Int?

  statusId    Int
  status      IssueStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  priorityId  Int
  priority    IssuePriority @relation(fields: [priorityId], references: [id], onDelete: Restrict)

  title       String
  description String?

  dueDate     DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  reporter    User  @relation("Reporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee    User? @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments    Comment[]
  histories   IssueHistory[]

  @@index([projectId])
  @@index([reporterId])
  @@index([assigneeId])
  @@index([statusId])
  @@index([priorityId])
  @@index([createdAt])
  @@index([projectId, statusId])
  @@index([projectId, assigneeId])
  @@map("issues")
}

//
// =======================
// Comment
// =======================
//

model Comment {
  id        Int @id @default(autoincrement())
  issueId   Int
  userId    Int

  content   String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  issue     Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  histories CommentHistory[]

  @@index([issueId])
  @@map("comments")
}

//
// =======================
// User History
// =======================
//
model UserHistory {
  id          Int      @id @default(autoincrement())

  userId       Int
  operatedBy   Int

  actionId     Int

  fieldName    HistoryField
  oldValue     Json?
  newValue     Json?

  createdAt    DateTime @default(now())

  user         User          @relation("UserHistoryTarget", fields: [userId], references: [id])
  operator     User          @relation("UserHistoryOperator", fields: [operatedBy], references: [id])
  action       HistoryAction @relation(fields: [actionId], references: [id])

  @@index([userId, createdAt])
  @@index([operatedBy, createdAt])
  @@map("user_histories")
}

//
// =======================
// Project History
// =======================
//

model ProjectHistory {
  id        Int @id @default(autoincrement())

  projectId Int
  userId    Int

  actionId Int

  fieldName HistoryField
  oldValue  Json?
  newValue  Json?

  createdAt DateTime @default(now())

  project Project       @relation(fields: [projectId], references: [id])
  user    User          @relation(fields: [userId], references: [id])
  action HistoryAction  @relation(fields:[actionId], references:[id])

  @@index([projectId, createdAt])
  @@map("project_histories")
}

//
// =======================
// Issue History
// =======================
//

model IssueHistory {
  id        Int @id @default(autoincrement())
  issueId   Int
  userId    Int

  actionId Int

  fieldName HistoryField
  oldValue  Json?
  newValue  Json?

  createdAt DateTime @default(now())

  issue     Issue           @relation(fields: [issueId], references: [id])
  user      User            @relation(fields: [userId], references: [id])
  action    HistoryAction   @relation(fields:[actionId], references:[id])

  @@index([issueId, createdAt])
  @@map("issue_histories")
}

//
// =======================
// Comment History
// =======================
//

model CommentHistory {
  id        Int @id @default(autoincrement())
  commentId   Int
  userId    Int

  actionId Int

  fieldName HistoryField
  oldValue  Json?
  newValue  Json?

  createdAt DateTime @default(now())

  comment     Comment        @relation(fields: [commentId], references: [id])
  user        User           @relation(fields: [userId], references: [id])
  action      HistoryAction  @relation(fields:[actionId], references:[id])

  @@index([commentId, createdAt])
  @@map("comment_histories")
}


//
// =======================
// Refresh Token
// =======================
//

model RefreshToken {
  id              Int @id @default(autoincrement())
  jti             String @unique
  userId          Int

  tokenHash       String    @unique
  expiresAt       DateTime
  replacedByToken String?
  revokedAt       DateTime?

  createdAt       DateTime @default(now())

  user            User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

//
// =======================
// API Log
// =======================
//

model ApiRequestLog {
  id        Int    @id @default(autoincrement())
  requestId String? @unique
  userId    Int?
  user      User?  @relation(fields: [userId], references: [id])
  method    String
  path      String
  status    Int
  duration  Int

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("api_logs")
}
